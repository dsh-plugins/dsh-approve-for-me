{
  "name": "@dsh-plugin/dsh-approve-for-me",
  "version": "0.4.1",
  "description": "DSH plugin: codex-like auto-approval for run commands 鈥?rules, full-auto, or a lightweight reviewer model (codex guardian style) 鈥?plus an \"Approve For Me\" (鏇挎垜鍚屾剰) option in the sandbox permission choices, with a live review status bar in the Web GUI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-approve-for-me.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "conversationEvents",
        "slots",
        "@dsh-plugin/dsh-loader"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.mjs",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "approval",
    "sandbox"
  ],
  "dependencies": {
    "schemastery": "^3.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-plugin/dsh-loader": "^1.3.0",
    "react": "^18.2.0"
  }
}
