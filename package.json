{
  "name": "@dsh-plugin/dsh-approve-for-me",
  "version": "2.0.0",
  "description": "DSH automatic approval rules and lightweight model review with a live review status bar.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-approve-for-me.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@dsh-plugin/dsh-loader"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.mjs",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "approval",
    "sandbox"
  ],
  "dependencies": {
    "schemastery": "^3.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.41037890182",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-plugin/dsh-loader": "^2.0.0-0",
    "react": "^18.2.0"
  }
}
